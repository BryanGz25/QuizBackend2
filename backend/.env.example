# Copie este archivo como .env y reemplace los valores. Nunca suba el .env al repositorio.
NODE_ENV=development
API_PORT=3000

# Usuario con permisos únicamente sobre estas bases de datos.
DATABASE_URL="mysql://USUARIO:CONTRASENA@localhost:3306/construct_inventory"
SHADOW_DATABASE_URL="mysql://USUARIO:CONTRASENA@localhost:3306/construct_inventory_shadow"
TEST_DATABASE_URL="mysql://USUARIO:CONTRASENA@localhost:3306/construct_inventory_test"

# Genere un valor aleatorio de al menos 32 caracteres.
JWT_SECRET="reemplazar-por-un-valor-aleatorio-de-32-caracteres"
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173

# Revisión programada de alertas y duplicados (cada 10 minutos).
ALERTAS_CRON="*/10 * * * *"

# Opcional: contraseña de los usuarios de demostración creados por la semilla.
# SEED_PASSWORD=
